# NyayamGPT Environment Configuration
# =====================================
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=NyayamGPT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS Settings
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Database Configuration
# =============================================================================
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./nyayamgpt.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nyayamgpt

DATABASE_ECHO=false

# =============================================================================
# Gemini API Configuration
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDU9nsinx2wVbmygKAhn2zyB_mQbznoyuE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-pro,gemini-2.0-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=2048

# =============================================================================
# Vector Store Configuration
# =============================================================================
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vectorstore
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# RAG Configuration
# =============================================================================
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# =============================================================================
# Validation Settings
# =============================================================================
MAX_VALIDATION_ATTEMPTS=3
VALIDATION_THRESHOLD=0.7

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# OpenTelemetry Tracing (Optional)
# =============================================================================
# Enable tracing by setting the endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nyayamgpt-backend
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
