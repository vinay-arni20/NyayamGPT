data/cache/
.cache/
*.cache

# Logs
logs/
*.log
*.log.*

# Environment variables
.env
.env.local
.env.production
.env.development
.env.test
backend/.env
frontend/.env

# API Keys (backup safety)
*api_key*
*secret*
.secrets/

# Alembic (Database migrations)
# Keep the migrations folder but ignore generated files if needed
# backend/alembic/versions/*.py

# Models and embeddings (large files)
*.bin
*.pt
*.pth
*.onnx
models/
embeddings/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.bak
*.backup

# Documentation builds
docs/_build/
site/

# Testing artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Docker
docker-compose.override.yml
.dockerignore

# Kubernetes
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ====================
# Large Data Files
# ====================
# Legal datasets (if regenerated)
# backend/data/*.json (uncomment if datasets are large and regenerated)

# User uploads
uploads/
user_data/

# Backups
backups/
*.backup
*.bak

# ====================
# CI/CD
# ====================
.github/workflows/*.log

# ====================
# Security
# ====================
# Certificate files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# SSH keys
id_rsa
id_rsa.pub
*.pub
known_hosts

# ====================
# Misc
# ====================
# MacOS Finder
.DS_Store

# Windows thumbnail cache
Thumbs.db

# Compressed files
*.zip
*.tar.gz
*.rar
*.7z

# Media files (if not part of project)
# *.mp4
# *.mp3
# *.avi

# PDFs (generated reports)
*.pdf

# Office files (temporary)
~$*.doc*
~$*.xls*
~$*.ppt*
