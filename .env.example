# =============================================================================
# NyayamGPT Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME=NyayamGPT
APP_VERSION=1.0.0

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=nyayam
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=nyayamgpt
DATABASE_URL=postgresql+asyncpg://nyayam:your_secure_password_here@db:5432/nyayamgpt

# For local development without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./data/nyayamgpt.db

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0

# For local development without Docker:
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI/LLM API Keys
# =============================================================================
# Google Gemini API (Primary)
GEMINI_API_KEY=your_google_api_key_here
# Fallback keys (comma-separated)
GEMINI_FALLBACK_KEYS=key2,key3,key4

# Legacy support
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API (Optional, for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Web Search (Choose one)
SERPAPI_KEY=your_serpapi_key_here
# Or use Google Custom Search:
# GOOGLE_SEARCH_API_KEY=your_google_search_api_key
# GOOGLE_SEARCH_CX=your_custom_search_engine_id

# =============================================================================
# Authentication & Security
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# =============================================================================
# CORS Settings
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# Observability (Optional)
# =============================================================================
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nyayamgpt-backend

# Sentry (Optional)
SENTRY_DSN=

# =============================================================================
# Frontend Settings (Vite)
# =============================================================================
VITE_API_URL=/api
VITE_APP_NAME=NyayamGPT
VITE_APP_VERSION=1.0.0

# =============================================================================
# Email Configuration (Optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@nyayamgpt.com

# =============================================================================
# Vector Store
# =============================================================================
CHROMA_PERSIST_DIRECTORY=./data/vectorstore
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# AI Model Settings
# =============================================================================
# Primary model for generation
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Validation settings
MAX_VALIDATION_ATTEMPTS=3

# Retrieval settings
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.65
